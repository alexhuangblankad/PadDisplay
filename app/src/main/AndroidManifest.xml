<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!--
        自绘光标浮层需要「显示在其他应用上层」。
        为什么必须自己画：系统只给真实鼠标（USB/uinput）画指针，
        应用侧注入的事件不会点亮它，非 root 没有别的接口。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PadDisplay"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PadDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku：本应用自己的 UserService（运行在 shell 权限进程内） -->
        <service
            android:name=".system.PadDisplayUserService"
            android:exported="false"
            android:process=":shizuku_service" />

        <!-- 触控板：用平板当外接屏的触控板（自绘光标 + 注入指针） -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:exported="false"
            android:label="触控板"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:theme="@style/Theme.PadDisplay" />

        <!-- Shizuku 权限申请入口 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>

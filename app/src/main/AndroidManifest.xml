<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <!-- Native Dock and window decorations; no cursor drawing or mouse event relay. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PadDisplay"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PadDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shizuku：本应用自己的 UserService（运行在 shell 权限进程内） -->
        <activity android:name=".desktop.DesktopActivity" android:exported="false"
            android:taskAffinity="com.paddisplay.app.externaldesktop"
            android:launchMode="singleTask" android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:theme="@style/Theme.PadDisplay" />
        <service android:name=".desktop.DesktopService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started physical external desktop session, taskbar and input/display reconnect recovery" />
        </service>
        <activity android:name=".desktop.EscapeNavigationActivity" android:exported="false"
            android:taskAffinity="com.paddisplay.app.escape" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:theme="@style/Theme.PadDisplay.Escape" />
        <service android:name=".desktop.DesktopShortcutService" android:exported="true"
            android:label="PadDisplay 全屏导航快捷键" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/desktop_shortcut_service" />
        </service>
        <service
            android:name=".system.PadDisplayUserService"
            android:exported="false"
            android:process=":shizuku_service" />

        <!-- 触控板：用平板当外接屏的触控板（自绘光标 + 注入指针） -->
        <activity
            android:name=".touchpad.TouchpadActivity"
            android:exported="false"
            android:label="触控板"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode"
            android:theme="@style/Theme.PadDisplay" />

        <!-- Shizuku 权限申请入口 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
